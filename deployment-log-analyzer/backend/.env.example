# Choose one provider (or leave all empty to run in pattern-library-only mode).
# LLM_PROVIDER=auto picks the first one configured: anthropic, azure_openai, openai.
LLM_PROVIDER=auto

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Leave the key empty to sign in with the host's managed identity / Entra ID instead.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Limits and behaviour ---
# MAX_UPLOAD_MB=200
# REDACT_FOR_LLM=true
# CORS_ORIGINS=["http://localhost:3000"]
# PATTERN_DIR=/app/custom-patterns
